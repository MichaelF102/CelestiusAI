# CelestiusAI - Environment Configuration Example
# Copy this file to .env and adjust variables as required.

# Application Configuration
APP_NAME="CelestiusAI"
APP_ENV="development"
LOG_LEVEL="INFO"

# Data Ingestion Limits
MAX_UPLOAD_SIZE_MB=100

# Agent Execution Bounds
AGENT_MAX_ITERATIONS=10
AGENT_EXECUTION_TIMEOUT_SECONDS=120

# Optional LLM Configuration (Phase 5 Evidence-Grounded AI Analyst)
# Default provider: gemini. Claude and Ollama (below) can also be chosen on the Settings page.
# LLM_PROVIDER="gemini"
# GEMINI_API_KEY="your-gemini-api-key-here"
# GEMINI_MODEL="gemini-1.5-pro"
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2

# Optional additional providers (can also be set per session on the Settings page)
# ANTHROPIC_API_KEY="your-anthropic-key"   # needs: pip install anthropic
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODEL="llama3.1"
