# AI Data Analyst Agent - Environment Configuration Example
# Copy this file to .env and adjust variables as required.

# Application Configuration
APP_NAME="AI Data Analyst Agent"
APP_ENV="development"
LOG_LEVEL="INFO"

# Data Ingestion Limits
MAX_UPLOAD_SIZE_MB=100

# Agent Execution Bounds
AGENT_MAX_ITERATIONS=10
AGENT_EXECUTION_TIMEOUT_SECONDS=120

# Optional LLM Configuration (Gemini API - Not required for Phase 1)
# GEMINI_API_KEY="your-gemini-api-key-here"
# GEMINI_MODEL="gemini-1.5-pro"
